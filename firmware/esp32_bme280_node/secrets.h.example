#pragma once

// Copy this file to "secrets.h" (in the same folder) and fill in your own
// values. secrets.h is gitignored, so it will never be committed.

#define WIFI_SSID "your_wifi_ssid"
#define WIFI_PASSWORD "your_wifi_password"

// Hostname or IP address of the hub ESP32 (the "Хол" device running
// esp32_bme280_dashboard). Default matches the hub's mDNS name.
#define HUB_ADDRESS "esp32-home.local"

// Unique id for this node - must match an entry the hub knows about
// (see DEVICE_BEDROOM in the hub's firmware).
#define DEVICE_ID "bedroom"
#define DEVICE_NAME "Спалня"

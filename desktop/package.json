{
  "name": "esp32-home-dashboard-desktop",
  "version": "1.0.1",
  "description": "Desktop wrapper for the ESP32 Home Dashboard web page.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2"
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.neptune4918.esp32homedashboard",
    "productName": "ESP32 Home Dashboard",
    "files": [
      "main.js",
      "preload.js",
      "panel.html",
      "panel.css",
      "panel.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/tray-icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "Neptune4918",
      "repo": "Esp32_Home_server"
    }
  }
}
